{
  "name": "deadlock-street-brawl-companion",
  "version": "0.8.0",
  "description": "Street Brawl companion for Windows and Linux with visible team and build tracking and contextual item guidance",
  "author": "Street Brawl Companion",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "overwolf": {
    "packages": [
      "gep"
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "start:overwolf": "node scripts/launch.mjs --overwolf",
    "package:dir": "npm run build && node scripts/build-native.mjs --target windows && electron-builder --dir --win --x64",
    "package:win": "npm run build && node scripts/build-native.mjs --target windows && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run build && node scripts/build-native.mjs --target linux && electron-builder --dir --linux --x64",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "reader:build": "node scripts/build-native.mjs",
    "reader:icons": "node scripts/sync-reader-icons.mjs --verify",
    "reader:context-icons": "node scripts/sync-context-icons.mjs --verify",
    "package:appimage": "npm run build && node scripts/build-native.mjs --target linux && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "42.11.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "local.deadlock.streetbrawl",
    "productName": "Street Brawl Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/reader-icons",
        "to": "reader-icons",
        "filter": [
          "manifest.json",
          "context-templates.bin",
          "context-templates.json",
          "icons/*.png"
        ]
      },
      {
        "from": "assets/context-icons",
        "to": "context-icons",
        "filter": [
          "manifest.json",
          "templates.bin",
          "templates.json",
          "heroes/*.png",
          "abilities/*.png",
          "glyphs/*.png"
        ]
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "rndaom",
        "repo": "deadlock-street-brawl-companion",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "artifactName": "Street-Brawl-Companion-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "native/ScreenReader/publish",
          "to": "screen-reader",
          "filter": [
            "ScreenReader.exe"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "street-brawl-companion",
      "category": "Game",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "native/ScreenReader/publish",
          "to": "screen-reader",
          "filter": [
            "ScreenReader"
          ]
        }
      ],
      "artifactName": "Street-Brawl-Companion-${version}-x86_64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Street Brawl Companion",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rndaom/deadlock-street-brawl-companion.git"
  },
  "homepage": "https://github.com/rndaom/deadlock-street-brawl-companion"
}

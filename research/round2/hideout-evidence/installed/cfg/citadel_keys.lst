		// The following set are intentionally not exposed to end users/rebindable.
		// They exist so that the glyph ui component has a common action to hook onto.
		// Functionally, there are no actions. These are merely stubs before doing any digital menu navigation pass.
		"MenuControls"
		{

			"OpenMainMenu" // CITADEL_KEYBIND_OPEN_MAIN_MENU
			{
				"Action"		""
				"AllowDuplicateBind" "1"
				"LocString"		"#citadel_keybind_open_main_menu"
			}

			// Some names here are holdovers from steam input manifest.
			"CursorSelect"
			{
				// Equvialent to left click when using console controls
				"Action"		""
				"LocString"		"#citadel_keybind_cursorselect"
			}

			"CursorContext"
			{
				// I.e. Alternate button press. Right Click or West face button on console controls
				"Action"		""
				"LocString"		"#citadel_keybind_cursorcontext"
			}

			"CursorMiddle"
			{
				// I.e. Alternate button press. Middle Click
				"Action"		""
				"LocString"		"#citadel_keybind_cursormiddle"
				// Mouse 3 on its own, or any of Mouse 1/2/3 as part of a chord
				"AllowedKeys"			"MOUSE1;MOUSE2;MOUSE3"
				"AllowedKeysNoModifier"	"MOUSE3"
				"RestrictionLocString"	"#citadel_keybind_popup_cursormiddle_restriction"
			}

			"MenuBack"
			{
				// Equivalent to Esc or East face button on console
				"Action"		""
				"AllowDuplicateBind" "1"
				"LocString"		"#citadel_keybind_menuback"
			}

			// Navigation directions.
			"MenuUp"
			{
				
				"Action"		""
				"LocString"		"#citadel_keybind_menuup"
			}

			"MenuDown"
			{
				"Action"		""
				"LocString"		"#citadel_keybind_menudown"
			}

			"MenuLeft"
			{
				"Action"		""
				"LocString"		"#citadel_keybind_menuleft"
			}

			"MenuRight"
			{
				"Action"		""
				"LocString"		"#citadel_keybind_menuright"
			}
		}
	}

